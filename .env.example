# Supabase project credentials (Project Settings → API in the Supabase dashboard).
# Required in every environment, including Vercel Project Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sincronização do ClubCut — só a rota /api/clubcut/uso usa. O resto do app
# funciona sem elas; sem CLUBCUT_SYNC_TOKEN a rota responde 503 e não grava.
# Ver docs/clubcut-sync.md.
SUPABASE_SERVICE_ROLE_KEY=
CLUBCUT_SYNC_TOKEN=
